{
  "$description": "Motion: M3 Expressive springs (decision 0001: Springs D), calm variants and the transition patterns. The build turns each spring (stiffness, damping, duration) into a CSS linear() easing. Effects springs never overshoot and keep running under reduced motion (fades are fine); spatial springs become instant.",
  "md": {
    "sys": {
      "motion": {
        "spring": {
          "fast-spatial": {
            "$description": "Small things that move or resize: switch handles, chips, button press shape. Overshoots about 3%.",
            "$extensions": {
              "com.s4.spring": true
            },
            "stiffness": {
              "$type": "number",
              "$value": 1400
            },
            "damping": {
              "$type": "number",
              "$value": 0.75
            },
            "duration": {
              "$type": "duration",
              "$value": {
                "value": 220,
                "unit": "ms"
              },
              "$extensions": {
                "com.s4.modes": {
                  "reduced-motion": {
                    "value": 0,
                    "unit": "ms"
                  }
                }
              }
            }
          },
          "spatial": {
            "$description": "Default for movement: nav indicators, menus emerging, dialogs and sheets opening, shared axis.",
            "$extensions": {
              "com.s4.spring": true
            },
            "stiffness": {
              "$type": "number",
              "$value": 900
            },
            "damping": {
              "$type": "number",
              "$value": 0.85
            },
            "duration": {
              "$type": "duration",
              "$value": {
                "value": 260,
                "unit": "ms"
              },
              "$extensions": {
                "com.s4.modes": {
                  "reduced-motion": {
                    "value": 0,
                    "unit": "ms"
                  }
                }
              }
            }
          },
          "slow-spatial": {
            "$description": "Large movement: full-screen container transforms, sheets from the edge.",
            "$extensions": {
              "com.s4.spring": true
            },
            "stiffness": {
              "$type": "number",
              "$value": 520
            },
            "damping": {
              "$type": "number",
              "$value": 0.9
            },
            "duration": {
              "$type": "duration",
              "$value": {
                "value": 340,
                "unit": "ms"
              },
              "$extensions": {
                "com.s4.modes": {
                  "reduced-motion": {
                    "value": 0,
                    "unit": "ms"
                  }
                }
              }
            }
          },
          "fast-effects": {
            "$description": "Small fades and color changes: state layers, icons.",
            "$extensions": {
              "com.s4.spring": true
            },
            "stiffness": {
              "$type": "number",
              "$value": 6000
            },
            "damping": {
              "$type": "number",
              "$value": 1
            },
            "duration": {
              "$type": "duration",
              "$value": {
                "value": 90,
                "unit": "ms"
              }
            }
          },
          "effects": {
            "$description": "Default fade and color change: content fading in, scrims.",
            "$extensions": {
              "com.s4.spring": true
            },
            "stiffness": {
              "$type": "number",
              "$value": 3500
            },
            "damping": {
              "$type": "number",
              "$value": 1
            },
            "duration": {
              "$type": "duration",
              "$value": {
                "value": 120,
                "unit": "ms"
              }
            }
          },
          "slow-effects": {
            "$description": "Slow fades: large surfaces.",
            "$extensions": {
              "com.s4.spring": true
            },
            "stiffness": {
              "$type": "number",
              "$value": 2000
            },
            "damping": {
              "$type": "number",
              "$value": 1
            },
            "duration": {
              "$type": "duration",
              "$value": {
                "value": 180,
                "unit": "ms"
              }
            }
          }
        }
      }
    }
  },
  "s4": {
    "motion": {
      "spring": {
        "fast-spatial-calm": {
          "$description": "Same stiffness as fast-spatial, critically damped: lands exactly on its target. For collapsing small things back into their source.",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 1400
          },
          "damping": {
            "$type": "number",
            "$value": 1
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 200,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "spatial-calm": {
          "$description": "Critically damped spatial: container transforms collapsing back into their source (never dips below it).",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 900
          },
          "damping": {
            "$type": "number",
            "$value": 1
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 260,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "slow-spatial-calm": {
          "$description": "Critically damped slow-spatial.",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 520
          },
          "damping": {
            "$type": "number",
            "$value": 1
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 340,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "ink": {
          "$description": "Decision 0042: ink (solid fills that show state: selection, radio and checkbox fills, nav and tab pill, switch, slider and progress fills) moves on a subtle liquid spring with a small overshoot.",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 1060
          },
          "damping": {
            "$type": "number",
            "$value": 0.8
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 250,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "rise": {
          "$description": "Decision 0042: glass surfaces (snackbars, glass items) rising into place. Plain: no stretching, barely any overshoot.",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 1060
          },
          "damping": {
            "$type": "number",
            "$value": 0.9
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 180,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "settle": {
          "$description": "Decision 0042: menu items following the glass in, rising 4px; anything settling the last few pixels into place.",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 1490
          },
          "damping": {
            "$type": "number",
            "$value": 1
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 220,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "tip": {
          "$description": "Decision 0042: tooltips rising 4px into place, fast.",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 2240
          },
          "damping": {
            "$type": "number",
            "$value": 0.9
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 120,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "reveal": {
          "$description": "Decision 0042: sections opening and closing (accordion height), calm and never instant.",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 775
          },
          "damping": {
            "$type": "number",
            "$value": 1
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 300,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        },
        "bend": {
          "$description": "Decision 0042: icons turning over (the accordion chevron bends like a page turned backward).",
          "$extensions": {
            "com.s4.spring": true
          },
          "stiffness": {
            "$type": "number",
            "$value": 860
          },
          "damping": {
            "$type": "number",
            "$value": 0.9
          },
          "duration": {
            "$type": "duration",
            "$value": {
              "value": 200,
              "unit": "ms"
            },
            "$extensions": {
              "com.s4.modes": {
                "reduced-motion": {
                  "value": 0,
                  "unit": "ms"
                }
              }
            }
          }
        }
      },
      "pattern": {
        "container-transform": {
          "$description": "Opening from a source (dialog from a button, sheet from a FAB, detail from a row): the source becomes the container at real size.",
          "content-fade-start": {
            "$type": "number",
            "$value": 0.35,
            "$description": "Container content fades in from this fraction of the move."
          },
          "source-fade-end": {
            "$type": "number",
            "$value": 0.3,
            "$description": "The source's label fades out by this fraction."
          }
        },
        "shared-axis": {
          "distance": {
            "$type": "dimension",
            "$value": {
              "value": 30,
              "unit": "px"
            },
            "$description": "How far views slide when switching between siblings."
          }
        },
        "unfold": {
          "start-scale": {
            "$type": "number",
            "$value": 0,
            "$description": "Legacy: the quiet unfold menu style (data-motion=\"quiet\"). Menus emerge from their button by default (decision 0018)."
          }
        }
      }
    }
  }
}
