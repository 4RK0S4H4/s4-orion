                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              }
            }
          }
        },
        "size": {
          "$type": "dimension",
          "$description": "How far the all-round glow reaches inward.",
          "$value": {
            "value": 12,
            "unit": "px"
          }
        },
        "top": {
