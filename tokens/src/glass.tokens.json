{
  "$description": "The glass layer (decision 0004): very clear frosted glass on floating chrome and overlays only, with a guaranteed contrast floor. The tint (75%, decision 0021) is firm enough that on-surface text on the glass meets WCAG AA over any backdrop, for every seed (checked by scripts/check-glass.mjs). High contrast, reduced transparency and browsers without backdrop-filter make glass solid.",
  "s4": {
    "glass": {
      "tint": {
        "$type": "color",
        "$description": "The surface role glass is tinted with.",
        "float": {
          "$value": "{md.sys.color.surface-container}",
          "$description": "App bars over scrolled content, nav bar, nav rail, toolbars, menus, sheets, dialogs, rich tooltips."
        },
        "fill": {
          "$value": "{md.sys.color.surface-container-highest}",
          "$description": "Tonal fills inside a glass surface (no blur of their own)."
        }
      },
      "tint-opacity": {
        "$type": "number",
        "$description": "How much of the tint role is painted over the blurred backdrop (0–1).",
        "float": {
          "$value": 0.75,
          "$extensions": {
            "com.s4.modes": {
              "high-contrast": 1,
              "dark-high-contrast": 1,
              "reduced-transparency": 1
            }
          },
          "$description": "Decision 0021: 75%, picked by the owner in the Glass Playground (was 0.6)."
        },
        "fab": {
          "$value": 0.75,
          "$extensions": {
            "com.s4.modes": {
              "high-contrast": 1,
              "dark-high-contrast": 1,
              "reduced-transparency": 1
            }
          },
          "$description": "Decision 0028: the owner's pick, the same 75% as the other glass. A floating action button is glass tinted with its own color. The icon keeps 4.5:1 or better in monochrome; with a seed the opaque FAB color pair is only 4.5:1 in the worst schemes, so over pure black or white directly behind it a few seeds drop to about 2.3:1 (scripts/check-glass.mjs reports it)."
        },
        "fill": {
          "$value": 0.56,
          "$extensions": {
            "com.s4.modes": {
              "dark": 0.64,
              "high-contrast": 1,
              "dark-high-contrast": 1,
              "reduced-transparency": 1
            }
          }
        },
        "medium-contrast": {
          "$value": 0.86,
          "$description": "Float tint when the app runs at medium contrast (contrast level 0.5)."
        }
      },
      "blur": {
        "$type": "dimension",
        "float": {
          "$value": {
            "value": 8,
            "unit": "px"
          },
          "$extensions": {
            "com.s4.modes": {
              "high-contrast": {
                "value": 0,
                "unit": "px"
              },
              "reduced-transparency": {
                "value": 0,
                "unit": "px"
              }
            }
          },
          "$description": "Backdrop blur radius. Decision 0021: 8px (owner's playground pick; was 16px)."
        }
      },
      "saturation": {
        "$type": "number",
        "float": {
          "$value": 1.5,
          "$description": "saturate() on the backdrop. Decision 0021: 150% (owner's playground pick; was 120% in 0014)."
        }
      },
      "backdrop-contrast": {
        "$type": "number",
        "float": {
          "$value": 1,
          "$extensions": {
            "com.s4.modes": {
              "dark": 1
            }
          },
          "$description": "contrast() on the backdrop. 1 (off) since decision 0021: the 75% tint alone keeps on-surface text at 4.5:1 or better over pure black or white (check-glass). Lower it below 1 only if the tint is lowered."
        }
      },
      "backdrop-brightness": {
        "$type": "number",
        "float": {
          "$value": 1,
          "$extensions": {
            "com.s4.modes": {
              "dark": 1
            }
          },
          "$description": "brightness() on the backdrop. 1 (off) since decision 0021, see backdrop-contrast."
        }
      },
      "max-stack": {
        "$type": "number",
        "$value": 2,
        "$description": "At most two glass layers overlap at any point (e.g. a menu over an app bar). A third becomes solid."
      },
      "item-fill": {
        "$type": "number",
        "$value": 1,
        "$description": "How much of its own color an item (button, chip, text field) keeps on glass, 1 = fully (decision 0015: owner picked full fill; lower it to let the blurred backdrop tint items)."
      },
      "item-outline": {
        "$type": "color",
        "$description": "The outline of an outline-only item on glass (outlined button, unselected chip): the glass's milky frost line, a little stronger than the edge (decision 0015). Zero in high contrast, where glass is solid and the item keeps its own outline.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "alpha": 0.28,
          "hex": "#ffffff"
        },
        "$extensions": {
          "com.s4.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [
                1,
                1,
                1
              ],
              "alpha": 0.28,
              "hex": "#ffffff"
            },
            "high-contrast": {
              "colorSpace": "srgb",
              "components": [
                1,
                1,
                1
              ],
              "alpha": 0,
              "hex": "#ffffff"
            },
            "dark-high-contrast": {
              "colorSpace": "srgb",
              "components": [
                1,
                1,
                1
              ],
              "alpha": 0,
              "hex": "#ffffff"
            },
            "reduced-transparency": {
              "colorSpace": "srgb",
              "components": [
                1,
                1,
                1
              ],
              "alpha": 0,
              "hex": "#ffffff"
            }
          }
        }
      },
      "edge": {
        "$description": "The glass edge (decision 0021, values corrected in 0027 to the owner's playground numbers: edge top 35, sides 50% of top, bottom 25; replaces the frost line of 0013/0016): light catches the top edge. Drawn as layered inset shadows so it follows the corner radius, never scrolls with content and needs no extra markup: a faint line all round (side), a brighter line along the top (top) and a faint return at the bottom (bottom). Full-width bars draw only one line on the edge that faces the content (line). All zero where glass is solid.",
        "width": {
          "$type": "dimension",
          "$value": {
            "value": 1,
            "unit": "px"
          }
        },
        "top": {
          "$type": "color",
          "$description": "Extra light along the top edge (on top of the side line).",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 1.0,
            "hex": "#ffffff"
          },
          "$extensions": {
            "com.s4.modes": {
              "dark": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0.3,
                "hex": "#ffffff"
              },
              "high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "dark-high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "reduced-transparency": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              }
            }
          }
        },
        "side": {
          "$type": "color",
          "$description": "The faint line all round.",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.19,
            "hex": "#ffffff"
          },
          "$extensions": {
            "com.s4.modes": {
              "dark": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0.06,
                "hex": "#ffffff"
              },
              "high-contrast": {
                "colorSpace": "srgb",
                "components": [
