                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "dark-high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "reduced-transparency": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              }
            }
          }
        },
        "bottom": {
          "$type": "color",
          "$description": "A faint return along the bottom edge.",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.09019607843137255,
              0.09019607843137255,
              0.10196078431372549
            ],
            "alpha": 0.16,
            "hex": "#17171a"
          },
          "$extensions": {
            "com.s4.modes": {
              "dark": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0.1,
                "hex": "#ffffff"
              },
              "high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "dark-high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "reduced-transparency": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
