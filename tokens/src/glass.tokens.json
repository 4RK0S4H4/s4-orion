                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              }
            }
          }
        },
        "line": {
          "$type": "color",
          "$description": "The single line full-width bars draw on their content-facing edge.",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.09019607843137255,
              0.09019607843137255,
              0.10196078431372549
            ],
            "alpha": 0.08,
            "hex": "#17171a"
          },
          "$extensions": {
            "com.s4.modes": {
