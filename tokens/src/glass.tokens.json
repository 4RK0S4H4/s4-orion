              },
              "reduced-transparency": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              }
            }
          }
        }
      },
      "glow": {
        "$description": "Optional brighter surface near the edges (decision 0028), drawn as inset box-shadows that follow the corner radius. Off by default (alpha 0); the owner turns it on from the Glass Playground. 'all' brightens the surface all round, 'top' only near the top edge (a sheen). Zero where glass is solid.",
        "all": {
          "$type": "color",
          "$description": "White glow all round, brightest at the very edge and fading inward over `size`.",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0,
            "hex": "#ffffff"
          },
          "$extensions": {
            "com.s4.modes": {
              "dark": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
